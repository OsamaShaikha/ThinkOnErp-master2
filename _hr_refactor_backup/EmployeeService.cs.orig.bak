using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading;
using System.Threading.Tasks;
using ThinkOnErp.Application.DTOs.Hr;
using ThinkOnErp.Domain.Entities.Hr;
using ThinkOnErp.Domain.Interfaces.Hr;

namespace ThinkOnErp.Application.Services.Hr;

public interface IEmployeeService
{
    Task<EmployeeDetailsDto> UpdateEmployeeBankAsync(string employeeCode,UpdateEmployeeBankDto dto,string user,CancellationToken cancellationToken=default);
    Task<EmployeeDetailsDto> UpdateEmployeeIdentityAsync(string employeeCode,UpdateEmployeeIdentityDto dto,string user,CancellationToken cancellationToken=default);
    Task<EmployeeDetailsDto> UpdateEmployeeWorkAsync(string employeeCode, UpdateEmployeeWorkDto dto, string user, CancellationToken cancellationToken = default);
    Task<(IReadOnlyList<EmployeeTeamMemberDto> Items, int TotalCount)> GetDirectReportsAsync(long userId, bool activeOnly, string? search, int pageIndex, int pageSize, CancellationToken cancellationToken = default);
    Task<(IReadOnlyList<EmployeeSummaryDto> Items, int TotalCount)> GetEmployeesPagedAsync(
        string? searchKeyword = null,
        string? departmentCode = null,
        string? status = null,
        long? branchId = null,
        int pageIndex = 1,
        int pageSize = 20,
        CancellationToken cancellationToken = default);

    Task<EmployeeDetailsDto?> GetEmployeeByCodeAsync(string employeeCode, CancellationToken cancellationToken = default);
    Task<EmployeeUserLinkDto?> GetEmployeeUserLinkAsync(long userId, CancellationToken cancellationToken = default);
    Task<EmployeeUserLinkDto> LinkEmployeeUserAsync(string employeeCode, long? userId, string user, CancellationToken cancellationToken = default);
    Task<EmployeeDetailsDto> CreateEmployeeAsync(CreateEmployeeDto dto, string user, CancellationToken cancellationToken = default);
    Task<EmployeeDetailsDto> UpdateEmployeeAsync(string employeeCode, UpdateEmployeeDto dto, string user, CancellationToken cancellationToken = default);
    Task DeleteEmployeeAsync(string employeeCode, string user, CancellationToken cancellationToken = default);

    Task<DependentDto> AddDependentAsync(string employeeCode, CreateDependentDto dto, string user, CancellationToken cancellationToken = default);
    Task DeleteDependentAsync(long dependentId, string user, CancellationToken cancellationToken = default);

    Task<SalaryStructureDetailsDto> AssignSalaryStructureAsync(string employeeCode, AssignSalaryStructureDto dto, string user, CancellationToken cancellationToken = default);
    Task<SalaryStructureDetailsDto?> GetActiveSalaryStructureAsync(string employeeCode, DateTime? asOfDate = null, CancellationToken cancellationToken = default);

    Task<IReadOnlyList<SalaryComponentDto>> GetSalaryComponentsAsync(CancellationToken cancellationToken = default);
    Task<SalaryComponentDto> CreateSalaryComponentAsync(CreateSalaryComponentDto dto, string user, CancellationToken cancellationToken = default);
}

public sealed class EmployeeService : IEmployeeService
{
    private readonly IEmployeeRepository _employeeRepo;
    private readonly IHrUnitOfWork? _unitOfWork;
    private readonly EmployeeFieldAccess? _fields;

    public EmployeeService(IEmployeeRepository employeeRepo, IHrUnitOfWork? unitOfWork = null, EmployeeFieldAccess? fields = null)
    {
        _employeeRepo = employeeRepo;
        _unitOfWork = unitOfWork;
        _fields = fields;
    }

    public async Task<(IReadOnlyList<EmployeeTeamMemberDto> Items, int TotalCount)> GetDirectReportsAsync(long userId, bool activeOnly, string? search,
        int pageIndex, int pageSize, CancellationToken cancellationToken = default)
    {
        if (userId <= 0 || pageIndex < 1 || pageSize is < 1 or > 200 || (long)(pageIndex - 1) * pageSize > int.MaxValue)
            throw new ArgumentException("Invalid team identity or page; pageSize must be between 1 and 200.");
        search = string.IsNullOrWhiteSpace(search) ? null : search.Trim();
        if (search?.Length > 200) throw new ArgumentException("Team search must not exceed 200 characters.");
        var (items, total) = await _employeeRepo.GetDirectReportsAsync(userId, activeOnly, search, pageIndex, pageSize, cancellationToken);
        return (items.Select(e => new EmployeeTeamMemberDto(e.EmployeeCode,e.NameLocal,e.NameEn,e.DepartmentCode,e.PositionCode,e.BranchId,e.EmploymentStatus,e.IsActive)).ToList(), total);
    }

    public async Task<EmployeeUserLinkDto?> GetEmployeeUserLinkAsync(long userId, CancellationToken cancellationToken = default)
    {
        var employee = await _employeeRepo.GetEmployeeByUserIdAsync(userId, cancellationToken);
        return employee == null ? null : new EmployeeUserLinkDto(employee.EmployeeCode, employee.UserId);
    }

    public async Task<EmployeeUserLinkDto> LinkEmployeeUserAsync(string employeeCode, long? userId, string user, CancellationToken cancellationToken = default)
    {
        employeeCode = EmployeeProfileRules.Required(employeeCode, "EmployeeCode", 100).ToUpperInvariant();
        user = EmployeeProfileRules.Required(user, "User", 100);
        if (userId <= 0) throw new ArgumentException("User ID must be positive.");
        if (_unitOfWork == null) throw new InvalidOperationException("Employee account changes require a protected unit of work.");
        return await _unitOfWork.ExecuteEmployeeAccountAsync(employeeCode,
            () => LinkEmployeeUserCoreAsync(employeeCode, userId, user, cancellationToken), cancellationToken);
    }

    private async Task<EmployeeUserLinkDto> LinkEmployeeUserCoreAsync(string employeeCode, long? userId, string user, CancellationToken cancellationToken)
    {
        var employee = await _employeeRepo.GetEmployeeByCodeAsync(employeeCode, cancellationToken)
            ?? throw new KeyNotFoundException($"Employee with code '{employeeCode}' not found.");

        if (userId.HasValue)
        {
            if (userId.Value <= 0)
                throw new ArgumentException("User ID must be positive.");
            if (!employee.IsActive || employee.EmploymentStatus != "ACTIVE")
                throw new InvalidOperationException("Only active employees can be linked to a login account.");
            if (!await _employeeRepo.IsUserAvailableForEmployeeAsync(userId.Value, employee.BranchId, cancellationToken))
                throw new InvalidOperationException("User must be active, exist in this tenant, and have access to the employee's branch.");
            var existing = await _employeeRepo.GetEmployeeByUserIdAsync(userId.Value, cancellationToken);
            if (existing != null && existing.EmployeeCode != employee.EmployeeCode)
                throw new InvalidOperationException("This user is already linked to another employee.");
        }

        if (employee.UserId == userId) return new EmployeeUserLinkDto(employee.EmployeeCode, employee.UserId);
        employee.UserId = userId;
        employee.UpdateUser = user;
        employee.UpdateDate = DateTime.UtcNow;
        await _employeeRepo.UpdateEmployeeUserLinkAsync(employee, cancellationToken);
        await _employeeRepo.SaveChangesAsync(cancellationToken);
        return new EmployeeUserLinkDto(employee.EmployeeCode, employee.UserId);
    }

    public async Task<(IReadOnlyList<EmployeeSummaryDto> Items, int TotalCount)> GetEmployeesPagedAsync(
        string? searchKeyword = null,
        string? departmentCode = null,
        string? status = null,
        long? branchId = null,
        int pageIndex = 1,
        int pageSize = 20,
        CancellationToken cancellationToken = default)
    {
        var (items, totalCount) = await _employeeRepo.GetEmployeesAsync(
            searchKeyword, departmentCode, status, branchId, pageIndex, pageSize, cancellationToken);
        var today = DateTime.UtcNow.Date;

        var dtos = items.Select(e =>
        {
            var activeStructure = e.SalaryStructures
                .Where(s => s.IsActive && s.EffectiveFrom.Date <= today && (!s.EffectiveTo.HasValue || s.EffectiveTo.Value.Date >= today))
                .OrderByDescending(s => s.EffectiveFrom)
                .FirstOrDefault();

            var dto = new EmployeeSummaryDto(
                e.EmployeeCode,
                e.NameLocal,
                e.NameEn,
                e.NationalId,
                e.DepartmentCode,
                e.PositionCode,
                e.EmploymentStatus,
                activeStructure?.BasicSalary,
                e.Phone,
                e.Email,
                e.UserId, e.BranchId
            );
            return _fields?.Protect(dto,e.BranchId) ?? dto;
        }).ToList();

        return (dtos, totalCount);
    }

    public async Task<EmployeeDetailsDto?> GetEmployeeByCodeAsync(string employeeCode, CancellationToken cancellationToken = default)
    {
        var emp = await _employeeRepo.GetEmployeeByCodeAsync(employeeCode, cancellationToken);
        if (emp == null) return null;

        return Details(emp);
    }

    public Task<EmployeeDetailsDto> CreateEmployeeAsync(CreateEmployeeDto dto, string user, CancellationToken cancellationToken = default)
    {
        ArgumentNullException.ThrowIfNull(dto);
        dto = EmployeeInputValidation.Normalize(dto);
        _fields?.Require(EmployeeFieldAccess.EditIdentity,dto.BranchId);
        if(dto.BankName!=null || dto.BankAccountNumber!=null || dto.BankIban!=null) _fields?.Require(EmployeeFieldAccess.EditBank,dto.BranchId);
        var unit = _unitOfWork ?? throw new InvalidOperationException("Payroll-protected employee creation requires a configured unit of work.");
        var row = new EmployeeImportRowDto { EmployeeCode = dto.EmployeeCode.Trim().ToUpperInvariant(), BranchId = dto.BranchId, HireDate = dto.HireDate.Date };
        return unit.ExecuteNewEmployeeAsync(row, () => CreateEmployeeCoreAsync(dto, user, cancellationToken), cancellationToken);
    }

    private async Task<EmployeeDetailsDto> CreateEmployeeCoreAsync(CreateEmployeeDto dto, string user, CancellationToken cancellationToken)
    {
        _fields?.Require(EmployeeFieldAccess.EditIdentity,dto.BranchId);
        if(dto.BankName!=null || dto.BankAccountNumber!=null || dto.BankIban!=null) _fields?.Require(EmployeeFieldAccess.EditBank,dto.BranchId);
        var normalizedCode = dto.EmployeeCode.Trim().ToUpperInvariant();
        if (await _employeeRepo.ExistsByCodeAsync(normalizedCode, cancellationToken))
        {
            throw new InvalidOperationException($"Employee with code '{dto.EmployeeCode}' already exists.");
        }

        if (await _employeeRepo.ExistsByNationalIdAsync(dto.NationalId, null, cancellationToken))
        {
            throw new InvalidOperationException("National ID is already assigned to another employee.");
        }

        var emp = new Employee
        {
            EmployeeCode = normalizedCode,
            NameLocal = dto.NameLocal,
            NameEn = dto.NameEn,
            NationalId = dto.NationalId,
            Nationality = dto.Nationality,
            CitizenshipCountryCode = string.IsNullOrEmpty(dto.CitizenshipCountryCode) ? null : dto.CitizenshipCountryCode,
            PassportNumber = dto.PassportNumber,
            DateOfBirth = dto.DateOfBirth,
            Gender = dto.Gender,
            MaritalStatus = dto.MaritalStatus,
            Email = dto.Email,
            Phone = dto.Phone,
            HireDate = dto.HireDate,
            ProbationEndDate = dto.ProbationEndDate,
            TerminationDate = dto.TerminationDate, TerminationReason = dto.TerminationReason,
            EmploymentType = dto.EmploymentType,
            EmploymentStatus = dto.EmploymentStatus,
            DepartmentCode = dto.DepartmentCode,
            PositionCode = dto.PositionCode,
            BranchId = dto.BranchId,
            ManagerEmployeeCode = dto.ManagerEmployeeCode,
            SscNumber = dto.SscNumber,
            TaxExemptionCount = dto.TaxExemptionCount,
            IsHighRiskRole = dto.IsHighRiskRole,
            BankName = dto.BankName,
            BankAccountNumber = dto.BankAccountNumber,
            BankIban = dto.BankIban,
            IsActive = dto.EmploymentStatus != "TERMINATED",
            CreationUser = user,
            CreationDate = DateTime.UtcNow
        };

        await _employeeRepo.AddEmployeeAsync(emp, cancellationToken);
        await _employeeRepo.SaveChangesAsync(cancellationToken);

        return Details(emp);
    }

    public Task<EmployeeDetailsDto> UpdateEmployeeAsync(string employeeCode, UpdateEmployeeDto dto, string user, CancellationToken cancellationToken = default)
    {
        ArgumentNullException.ThrowIfNull(dto);
        employeeCode = EmployeeProfileRules.Required(employeeCode, nameof(employeeCode), 100).ToUpperInvariant();
        dto = EmployeeInputValidation.Normalize(employeeCode, dto);
        _fields?.Require(EmployeeFieldAccess.EditIdentity,dto.BranchId);
        _fields?.Require(EmployeeFieldAccess.EditBank,dto.BranchId);
        return ProtectProfile(employeeCode, dto.HireDate.Date, () => UpdateEmployeeCoreAsync(employeeCode, dto, user, cancellationToken), cancellationToken);
    }

    private async Task<EmployeeDetailsDto> UpdateEmployeeCoreAsync(string employeeCode, UpdateEmployeeDto dto, string user, CancellationToken cancellationToken, bool limitedUpdate = false)
    {
        var emp = await _employeeRepo.GetEmployeeByCodeAsync(employeeCode, cancellationToken);
        if (emp == null) throw new KeyNotFoundException($"Employee with code '{employeeCode}' not found.");

        if (!string.Equals(emp.EmploymentStatus, dto.EmploymentStatus, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(dto.EmploymentStatus, "TERMINATED", StringComparison.OrdinalIgnoreCase))
            throw new InvalidOperationException("Employee termination must be completed through the End of Service workflow.");
        if (dto.TerminationDate?.Date != emp.TerminationDate?.Date ||
            !string.Equals(dto.TerminationReason?.Trim(), emp.TerminationReason?.Trim(), StringComparison.Ordinal))
            throw new InvalidOperationException("Termination date and reason can only be changed through the End of Service workflow.");

        foreach(var branch in new[] { emp.BranchId,dto.BranchId }.Distinct())
        {
            if(!limitedUpdate || emp.BranchId!=dto.BranchId)
            { _fields?.Require(EmployeeFieldAccess.EditIdentity,branch); _fields?.Require(EmployeeFieldAccess.EditBank,branch); }
            if(emp.BranchId!=dto.BranchId) _fields?.Require(EmployeeFieldAccess.EditSalary,branch);
        }

        if (emp.UserId.HasValue && emp.BranchId != dto.BranchId &&
            !await _employeeRepo.IsUserAvailableForEmployeeAsync(emp.UserId.Value, dto.BranchId, cancellationToken))
            throw new InvalidOperationException("The linked user must have access to the new employee branch. Unlink the account or assign its branch access first.");

        if (await _employeeRepo.ExistsByNationalIdAsync(dto.NationalId, employeeCode, cancellationToken))
        {
            throw new InvalidOperationException("National ID is already assigned to another employee.");
        }

        emp.NameLocal = dto.NameLocal;
        emp.NameEn = dto.NameEn;
        emp.NationalId = dto.NationalId;
        emp.Nationality = dto.Nationality;
        if (dto.CitizenshipCountryCode != null)
            emp.CitizenshipCountryCode = string.IsNullOrEmpty(dto.CitizenshipCountryCode) ? null : dto.CitizenshipCountryCode;
        emp.PassportNumber = dto.PassportNumber;
        emp.DateOfBirth = dto.DateOfBirth;
        emp.Gender = dto.Gender;
        emp.MaritalStatus = dto.MaritalStatus;
        emp.Email = dto.Email;
        emp.Phone = dto.Phone;
        emp.HireDate = dto.HireDate;
        emp.ProbationEndDate = dto.ProbationEndDate;
        emp.TerminationDate = dto.TerminationDate;
        emp.TerminationReason = dto.TerminationReason;
        emp.EmploymentType = dto.EmploymentType;
        emp.EmploymentStatus = dto.EmploymentStatus;
        emp.DepartmentCode = dto.DepartmentCode;
        emp.PositionCode = dto.PositionCode;
        emp.BranchId = dto.BranchId;
        emp.ManagerEmployeeCode = dto.ManagerEmployeeCode;
        emp.SscNumber = dto.SscNumber;
        emp.TaxExemptionCount = dto.TaxExemptionCount;
        emp.IsHighRiskRole = dto.IsHighRiskRole;
        emp.BankName = dto.BankName;
        emp.BankAccountNumber = dto.BankAccountNumber;
        emp.BankIban = dto.BankIban;
        emp.IsActive = dto.IsActive;
        emp.UpdateUser = user;
        emp.UpdateDate = DateTime.UtcNow;

        await _employeeRepo.UpdateEmployeeAsync(emp, cancellationToken);
        await _employeeRepo.SaveChangesAsync(cancellationToken);

        return Details(emp);
    }

    public Task<EmployeeDetailsDto> UpdateEmployeeWorkAsync(string employeeCode,UpdateEmployeeWorkDto dto,string user,CancellationToken cancellationToken=default)
    {
        ArgumentNullException.ThrowIfNull(dto);
        employeeCode=EmployeeProfileRules.Required(employeeCode,nameof(employeeCode),100).ToUpperInvariant();
        return ProtectProfile(employeeCode,dto.HireDate.Date,async ()=>
        {
            var e=await _employeeRepo.GetEmployeeByCodeAsync(employeeCode,cancellationToken) ?? throw new KeyNotFoundException("Employee not found.");
            var replacement=new UpdateEmployeeDto(dto.NameLocal,dto.NameEn,e.NationalId,e.Nationality,e.PassportNumber,e.DateOfBirth,e.Gender,e.MaritalStatus,e.Email,e.Phone,
                dto.HireDate,dto.ProbationEndDate,dto.TerminationDate,dto.TerminationReason,dto.EmploymentType,dto.EmploymentStatus,dto.DepartmentCode,dto.PositionCode,dto.BranchId,
                dto.ManagerEmployeeCode,e.SscNumber,e.TaxExemptionCount,e.IsHighRiskRole,e.BankName,e.BankAccountNumber,e.BankIban,dto.IsActive);
            replacement=EmployeeInputValidation.Normalize(employeeCode,replacement);
            return await UpdateEmployeeCoreAsync(employeeCode,replacement,user,cancellationToken,limitedUpdate:true);
        },cancellationToken);
    }

    private static UpdateEmployeeDto StoredProfile(Employee e)=>new(e.NameLocal,e.NameEn,e.NationalId,e.Nationality,e.PassportNumber,e.DateOfBirth,e.Gender,e.MaritalStatus,e.Email,e.Phone,
        e.HireDate,e.ProbationEndDate,e.TerminationDate,e.TerminationReason,e.EmploymentType,e.EmploymentStatus,e.DepartmentCode,e.PositionCode,e.BranchId,e.ManagerEmployeeCode,
        e.SscNumber,e.TaxExemptionCount,e.IsHighRiskRole,e.BankName,e.BankAccountNumber,e.BankIban,e.IsActive,e.CitizenshipCountryCode);

    public Task<EmployeeDetailsDto> UpdateEmployeeBankAsync(string employeeCode,UpdateEmployeeBankDto dto,string user,CancellationToken cancellationToken=default)
    {
        ArgumentNullException.ThrowIfNull(dto);
        return UpdatePrivateGroup(employeeCode,EmployeeFieldAccess.EditBank,e=>StoredProfile(e) with { BankName=dto.BankName,BankAccountNumber=dto.BankAccountNumber,BankIban=dto.BankIban },user,cancellationToken);
    }

    public Task<EmployeeDetailsDto> UpdateEmployeeIdentityAsync(string employeeCode,UpdateEmployeeIdentityDto dto,string user,CancellationToken cancellationToken=default)
    {
        ArgumentNullException.ThrowIfNull(dto);
        var normalizedCode = CountryCodeRules.NormalizeOptional(dto.CitizenshipCountryCode);
        return UpdatePrivateGroup(employeeCode,EmployeeFieldAccess.EditIdentity,e=>StoredProfile(e) with { NationalId=dto.NationalId,Nationality=dto.Nationality,PassportNumber=dto.PassportNumber,
            CitizenshipCountryCode=dto.CitizenshipCountryCode == null ? e.CitizenshipCountryCode : normalizedCode,
            DateOfBirth=dto.DateOfBirth,Gender=dto.Gender,MaritalStatus=dto.MaritalStatus,Email=dto.Email,Phone=dto.Phone,SscNumber=dto.SscNumber,TaxExemptionCount=dto.TaxExemptionCount,IsHighRiskRole=dto.IsHighRiskRole },user,cancellationToken);
    }

    private async Task<EmployeeDetailsDto> UpdatePrivateGroup(string employeeCode,string feature,Func<Employee,UpdateEmployeeDto> replace,string user,CancellationToken ct)
    {
        employeeCode=EmployeeProfileRules.Required(employeeCode,nameof(employeeCode),100).ToUpperInvariant();
        var before=await _employeeRepo.GetEmployeeByCodeAsync(employeeCode,ct) ?? throw new KeyNotFoundException("Employee not found.");
        _fields?.Require(feature,before.BranchId);
        return await ProtectProfile(employeeCode,null,async ()=>
        {
            var current=await _employeeRepo.GetEmployeeByCodeAsync(employeeCode,ct) ?? throw new KeyNotFoundException("Employee not found.");
            _fields?.Require(feature,current.BranchId);
            var replacement=EmployeeInputValidation.Normalize(employeeCode,replace(current));
            // Group writers copy every other field from the newly locked row.
            return await UpdateEmployeeCoreAsync(employeeCode,replacement,user,ct,limitedUpdate:true);
        },ct);
    }

    private EmployeeDetailsDto Details(Employee employee)
    { var dto=MapToDetailsDto(employee); return _fields?.Protect(dto) ?? dto; }

    public async Task DeleteEmployeeAsync(string employeeCode, string user, CancellationToken cancellationToken = default)
        => await ProtectProfile(employeeCode, null, async () => { await DeleteEmployeeCoreAsync(employeeCode, user, cancellationToken); return true; }, cancellationToken);

    private async Task DeleteEmployeeCoreAsync(string employeeCode, string user, CancellationToken cancellationToken)
    {
        var emp = await _employeeRepo.GetEmployeeByCodeAsync(employeeCode, cancellationToken);
        if (emp == null) throw new KeyNotFoundException($"Employee with code '{employeeCode}' not found.");
        throw new InvalidOperationException("Employees cannot be terminated or deleted through this endpoint. Complete termination through End of Service.");
    }

    public Task<DependentDto> AddDependentAsync(string employeeCode, CreateDependentDto dto, string user, CancellationToken cancellationToken = default)
    {
        ArgumentNullException.ThrowIfNull(dto);
        return ProtectProfile(employeeCode, null, () => AddDependentCoreAsync(employeeCode, dto, user, cancellationToken), cancellationToken);
    }

    private async Task<DependentDto> AddDependentCoreAsync(string employeeCode, CreateDependentDto dto, string user, CancellationToken cancellationToken)
    {
        var emp = await _employeeRepo.GetEmployeeByCodeAsync(employeeCode, cancellationToken);
        if (emp == null) throw new InvalidOperationException($"Employee with code '{employeeCode}' not found.");
        _fields?.Require(EmployeeFieldAccess.EditIdentity,emp.BranchId);
        _fields?.Require(EmployeeFieldAccess.ViewIdentity,emp.BranchId);

        var dep = new EmployeeDependent
        {
            EmployeeCode = employeeCode,
            NameLocal = dto.NameLocal,
            NameEn = dto.NameEn,
            Relationship = dto.Relationship,
            DateOfBirth = dto.DateOfBirth,
            Gender = dto.Gender,
            NationalId = dto.NationalId,
            IsTaxExemptionClaimed = dto.IsTaxExemptionClaimed,
            IsMedicalCovered = dto.IsMedicalCovered,
            IsActive = true,
            CreationUser = user,
            CreationDate = DateTime.UtcNow
        };
        EmployeeDependentRules.NormalizeAndValidate(dep);

        await _employeeRepo.AddDependentAsync(dep, cancellationToken);

        // TaxExemptionCount is for additional manual exemptions; dependents are counted separately.

        await _employeeRepo.SaveChangesAsync(cancellationToken);

        return new DependentDto(
            dep.Id,
            dep.EmployeeCode,
            dep.NameLocal,
            dep.NameEn,
            dep.Relationship,
            dep.DateOfBirth,
            dep.Gender,
            dep.NationalId,
            dep.IsTaxExemptionClaimed,
            dep.IsMedicalCovered,
            dep.IsActive
        );
    }

    public async Task DeleteDependentAsync(long dependentId, string user, CancellationToken cancellationToken = default)
    {
        var snapshot = await _employeeRepo.GetDependentByIdAsync(dependentId, cancellationToken)
            ?? throw new KeyNotFoundException("Dependent not found in current HR scope.");
        var employeeCode = snapshot.EmployeeCode;
        await ProtectProfile(employeeCode, null, async () =>
        {
            var current = await _employeeRepo.GetDependentByIdAsync(dependentId, cancellationToken)
                ?? throw new KeyNotFoundException("Dependent no longer exists in current HR scope.");
            if (current.EmployeeCode != employeeCode) throw new InvalidOperationException("Dependent ownership changed. Reload and retry.");
            var parent=await _employeeRepo.GetEmployeeByCodeAsync(employeeCode,cancellationToken) ?? throw new KeyNotFoundException("Employee not found.");
            _fields?.Require(EmployeeFieldAccess.EditIdentity,parent.BranchId);
            await _employeeRepo.DeleteDependentAsync(current, cancellationToken); await _employeeRepo.SaveChangesAsync(cancellationToken); return true;
        }, cancellationToken);
    }

    private async Task<T> ProtectProfile<T>(string employeeCode, DateTime? requestedHireDate, Func<Task<T>> action, CancellationToken ct)
    {
        var unit = _unitOfWork ?? throw new InvalidOperationException("Payroll-protected employee profile changes require a configured unit of work.");
        var current = await _employeeRepo.GetEmployeeByCodeAsync(employeeCode, ct) ?? throw new KeyNotFoundException("Employee not found in current HR scope.");
        var from = requestedHireDate.HasValue && requestedHireDate.Value.Date < current.HireDate.Date ? requestedHireDate.Value.Date : current.HireDate.Date;
        // The present profile and dependents are undated payroll snapshot inputs. Their
        // mutations can change historic/future results, so protect the full affected history.
        return await unit.ExecuteEmployeeProfileAsync(employeeCode, from, action, ct);
    }

    public async Task<SalaryStructureDetailsDto> AssignSalaryStructureAsync(string employeeCode, AssignSalaryStructureDto dto, string user, CancellationToken cancellationToken = default)
    {
        ArgumentNullException.ThrowIfNull(dto);
        // Salary structures are effective by calendar day throughout HR and payroll.
        // Normalize once so time components cannot change validation or truncation.
        dto = dto with { EffectiveFrom = dto.EffectiveFrom.Date, EffectiveTo = dto.EffectiveTo?.Date };
        if(_fields!=null)
        {
            var employee=await _employeeRepo.GetEmployeeByCodeAsync(employeeCode,cancellationToken) ?? throw new KeyNotFoundException("Employee not found.");
            _fields.Require(EmployeeFieldAccess.EditSalary,employee.BranchId); _fields.Require(EmployeeFieldAccess.ViewSalary,employee.BranchId);
            if(_unitOfWork==null) throw new InvalidOperationException("Payroll-protected salary assignment requires a unit of work.");
        }
        if (dto.BasicSalary < 0 || (dto.EffectiveTo.HasValue && dto.EffectiveTo.Value.Date < dto.EffectiveFrom.Date))
            throw new ArgumentException("Salary amount and effective date range are invalid.");
        // Assigning a structure also truncates the preceding one, potentially affecting every
        // later period even when the newly assigned structure has a finite end date.
        return await (_unitOfWork == null ? AssignSalaryStructureCoreAsync(employeeCode, dto, user, cancellationToken)
            : _unitOfWork.ExecuteForEmployeeDatesAsync(employeeCode, dto.EffectiveFrom.Date, DateTime.MaxValue.Date,
                () => AssignSalaryStructureCoreAsync(employeeCode, dto, user, cancellationToken), cancellationToken));
    }

    private async Task<SalaryStructureDetailsDto> AssignSalaryStructureCoreAsync(string employeeCode, AssignSalaryStructureDto dto, string user, CancellationToken cancellationToken)
    {
        var emp = await _employeeRepo.GetEmployeeByCodeAsync(employeeCode, cancellationToken);
        if (emp == null) throw new InvalidOperationException($"Employee with code '{employeeCode}' not found.");
        _fields?.Require(EmployeeFieldAccess.EditSalary,emp.BranchId);
        _fields?.Require(EmployeeFieldAccess.ViewSalary,emp.BranchId);
        dto=dto with { CurrencyCode=SalaryPaymentMetadata.Normalize(dto.CurrencyCode),PaymentMethod=SalaryPaymentMetadata.Normalize(dto.PaymentMethod) };
        SalaryPaymentMetadata.Validate(dto.CurrencyCode,dto.PaymentMethod);
        await _employeeRepo.ValidateSalaryMetadataAsync(dto.CurrencyCode,dto.PaymentMethod,cancellationToken);

        if (dto.BasicSalary < 0 || (dto.EffectiveTo.HasValue && dto.EffectiveTo.Value.Date < dto.EffectiveFrom.Date))
            throw new ArgumentException("Salary amount and effective date range are invalid.");
        var validatedLines = new List<(string ComponentCode, decimal Amount, decimal? Percent)>();
        foreach (var line in dto.Lines ?? new List<SalaryStructureLineDto>())
        {
            var componentCode = line.ComponentCode?.Trim();
            if (string.IsNullOrWhiteSpace(componentCode) || componentCode.Length > 50)
                throw new ArgumentException("Salary structure component code is required and cannot exceed 50 characters.");
            var component = await _employeeRepo.GetSalaryComponentByCodeAsync(componentCode, cancellationToken)
                ?? throw new ArgumentException($"Salary component '{componentCode}' does not exist.");
            var amount = SalaryStructureLineRules.ResolveInputAmount(line.Amount, component);
            var candidate = new SalaryStructureLine
            {
                ComponentCode = component.ComponentCode,
                Amount = amount,
                Percent = line.Percent
            };
            SalaryStructureLineRules.ValidateAssignment(candidate, component, dto.BasicSalary);
            validatedLines.Add((component.ComponentCode, amount, line.Percent == 0m ? null : line.Percent));
        }

        var existingStructures = await _employeeRepo.GetSalaryStructuresAsync(employeeCode, cancellationToken);
        if (existingStructures.Any(s => s.IsActive && s.EffectiveFrom.Date >= dto.EffectiveFrom.Date))
            throw new InvalidOperationException("A salary structure already starts on or after this date. Update or remove that future structure before assigning a backdated salary.");
        foreach (var existing in existingStructures.Where(s => s.IsActive && s.EffectiveFrom.Date < dto.EffectiveFrom.Date && (!s.EffectiveTo.HasValue || s.EffectiveTo.Value.Date >= dto.EffectiveFrom.Date)))
        {
            existing.EffectiveTo = dto.EffectiveFrom.Date.AddDays(-1);
            existing.UpdateUser = user;
            existing.UpdateDate = DateTime.UtcNow;
        }

        var structure = new SalaryStructure
        {
            EmployeeCode = employeeCode,
            EffectiveFrom = dto.EffectiveFrom,
            EffectiveTo = dto.EffectiveTo,
            BasicSalary = dto.BasicSalary,
            CurrencyCode = dto.CurrencyCode,
            PaymentMethod = dto.PaymentMethod,
            IsActive = true,
            CreationUser = user,
            CreationDate = DateTime.UtcNow
        };

        if (validatedLines.Count > 0)
        {
            foreach (var line in validatedLines)
            {
                structure.Lines.Add(new SalaryStructureLine
                {
                    ComponentCode = line.ComponentCode,
                    Amount = line.Amount,
                    Percent = line.Percent,
                    IsActive = true,
                    CreationUser = user,
                    CreationDate = DateTime.UtcNow
                });
            }
        }

        await _employeeRepo.AddSalaryStructureAsync(structure, cancellationToken);
        await _employeeRepo.SaveChangesAsync(cancellationToken);

        // Fetch reloaded structure with component names
        var active = await _employeeRepo.GetActiveSalaryStructureAsync(employeeCode, dto.EffectiveFrom, cancellationToken);
        return MapToStructureDetailsDto(active ?? structure);
    }

    public async Task<SalaryStructureDetailsDto?> GetActiveSalaryStructureAsync(string employeeCode, DateTime? asOfDate = null, CancellationToken cancellationToken = default)
    {
        if(_fields!=null)
        {
            var employee=await _employeeRepo.GetEmployeeByCodeAsync(employeeCode,cancellationToken) ?? throw new KeyNotFoundException("Employee not found.");
            _fields.Require(EmployeeFieldAccess.ViewSalary,employee.BranchId);
        }
        var targetDate = asOfDate ?? DateTime.UtcNow;
        var structure = await _employeeRepo.GetActiveSalaryStructureAsync(employeeCode, targetDate, cancellationToken);
        return structure == null ? null : MapToStructureDetailsDto(structure);
    }

    public async Task<IReadOnlyList<SalaryComponentDto>> GetSalaryComponentsAsync(CancellationToken cancellationToken = default)
    {
        var components = await _employeeRepo.GetSalaryComponentsAsync(cancellationToken);
        return components.Select(c => new SalaryComponentDto(
            c.ComponentCode,
            c.NameLocal,
            c.NameEn,
            c.ComponentType,
            c.CalculationType,
            c.DefaultAmount,
            c.DefaultPercent,
            c.IsTaxable,
            c.IsSscApplicable,
            c.GlAccountCode,
            c.IsActive
        )).ToList();
    }

    public async Task<SalaryComponentDto> CreateSalaryComponentAsync(CreateSalaryComponentDto dto, string user, CancellationToken cancellationToken = default)
    {
        ArgumentNullException.ThrowIfNull(dto);
        var component = new SalaryComponent
        {
            ComponentCode = dto.ComponentCode,
            NameLocal = dto.NameLocal,
            NameEn = dto.NameEn,
            ComponentType = dto.ComponentType,
            CalculationType = dto.CalculationType,
            DefaultAmount = dto.DefaultAmount,
            DefaultPercent = dto.DefaultPercent,
            IsTaxable = dto.IsTaxable,
            IsSscApplicable = dto.IsSscApplicable,
            GlAccountCode = dto.GlAccountCode,
            IsActive = true,
            CreationUser = user,
            CreationDate = DateTime.UtcNow
        };
        SalaryComponentRules.NormalizeAndValidate(component);

        var existing = await _employeeRepo.GetSalaryComponentByCodeAsync(component.ComponentCode, cancellationToken);
        if (existing != null)
        {
            throw new InvalidOperationException($"Salary component '{component.ComponentCode}' already exists.");
        }

        await _employeeRepo.AddSalaryComponentAsync(component, cancellationToken);
        await _employeeRepo.SaveChangesAsync(cancellationToken);

        return new SalaryComponentDto(
            component.ComponentCode,
            component.NameLocal,
            component.NameEn,
            component.ComponentType,
            component.CalculationType,
            component.DefaultAmount,
            component.DefaultPercent,
            component.IsTaxable,
            component.IsSscApplicable,
            component.GlAccountCode,
            component.IsActive
        );
    }

    private static EmployeeDetailsDto MapToDetailsDto(Employee emp)
    {
        var today = DateTime.UtcNow.Date;
        var activeStructure = emp.SalaryStructures
            .Where(s => s.IsActive && s.EffectiveFrom.Date <= today && (!s.EffectiveTo.HasValue || s.EffectiveTo.Value.Date >= today))
            .OrderByDescending(s => s.EffectiveFrom)
            .FirstOrDefault();

        var dependents = emp.Dependents.Select(d => new DependentDto(
            d.Id,
            d.EmployeeCode,
            d.NameLocal,
            d.NameEn,
            d.Relationship,
            d.DateOfBirth,
            d.Gender,
            d.NationalId,
            d.IsTaxExemptionClaimed,
            d.IsMedicalCovered,
            d.IsActive
        )).ToList();

        return new EmployeeDetailsDto(
            emp.EmployeeCode,
            emp.NameLocal,
            emp.NameEn,
            emp.NationalId,
            emp.Nationality,
            emp.PassportNumber,
            emp.DateOfBirth,
            emp.Gender,
            emp.MaritalStatus,
            emp.Email,
            emp.Phone,
            emp.HireDate,
            emp.ProbationEndDate,
            emp.TerminationDate,
            emp.TerminationReason,
            emp.EmploymentType,
            emp.EmploymentStatus,
            emp.DepartmentCode,
            emp.PositionCode,
            emp.BranchId,
            emp.ManagerEmployeeCode,
            emp.SscNumber,
            emp.TaxExemptionCount,
            emp.IsHighRiskRole,
            emp.BankName,
            emp.BankAccountNumber,
            emp.BankIban,
            emp.IsActive,
            dependents,
            activeStructure == null ? null : MapToStructureDetailsDto(activeStructure),
            emp.UserId
        ) { CitizenshipCountryCode = emp.CitizenshipCountryCode };
    }

    private static SalaryStructureDetailsDto MapToStructureDetailsDto(SalaryStructure s)
    {
        var lines = s.Lines.Select(l => new SalaryStructureLineDetailDto(
            l.Id,
            l.ComponentCode,
            l.Component?.NameLocal ?? l.ComponentCode,
            l.Component?.NameEn ?? l.ComponentCode,
            l.Component?.ComponentType ?? "ALLOWANCE",
            l.Amount,
            l.Percent,
            l.IsActive
        )).ToList();

        return new SalaryStructureDetailsDto(
            s.Id,
            s.EmployeeCode,
            s.EffectiveFrom,
            s.EffectiveTo,
            s.BasicSalary,
            s.CurrencyCode,
            s.PaymentMethod,
            s.IsActive,
            lines
        );
    }
}

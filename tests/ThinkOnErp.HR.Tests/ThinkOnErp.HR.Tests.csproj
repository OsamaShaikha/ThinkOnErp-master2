<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ThinkOnErp.Domain\ThinkOnErp.Domain.csproj" />
    <ProjectReference Include="..\..\src\ThinkOnErp.Application\ThinkOnErp.Application.csproj" />
    <ProjectReference Include="..\..\src\ThinkOnErp.Infrastructure\ThinkOnErp.Infrastructure.csproj" />
  </ItemGroup>

  <!-- POS scenarios do not belong to the HR suite. Keep their legacy source opt-in so
       broken POS fixtures cannot prevent HR regression tests from compiling. -->
  <ItemGroup>
    <Compile Remove="Validation\Pos*.cs;Validation\InvoiceBusinessValidationServiceTests.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(RunLegacyPosTests)' == 'true'">
    <Compile Include="Validation\Pos*.cs;Validation\InvoiceBusinessValidationServiceTests.cs" />
  </ItemGroup>

  <!-- Focused workflow regression run, independent of legacy POS test compilation. -->
  <ItemGroup Condition="'$(PayrollAdjustmentWorkflowOnly)' == 'true'">
    <Compile Remove="**/*.cs" />
    <Compile Include="PayrollAdjustmentWorkflowTests.cs" />
    <Compile Include="PayrollInputSnapshotTests.cs" />
    <Compile Include="HrAccountingOwnershipTests.cs" />
    <Compile Include="LoanDeductionServiceTests.cs" />
    <Compile Include="LeavePayrollLockTests.cs" />
    <Compile Include="LeaveClosedCycleTests.cs" />
    <Compile Include="LeaveYearCloseAuditTests.cs" />
    <Compile Include="LeaveLedgerTests.cs" />
    <Compile Include="EffectiveShiftTests.cs" />
    <Compile Include="ShiftDefinitionTests.cs" />
    <Compile Include="ShiftAssignmentTests.cs" />
    <Compile Include="ShiftDayTests.cs" />
    <Compile Include="ShiftGenerationTests.cs" />
    <Compile Include="ShiftTimingTests.cs" />
    <Compile Include="ScheduledAttendanceTests.cs" />
    <Compile Include="AttendanceDayStatusTests.cs" />
    <Compile Include="MobilePunchIdempotencyTests.cs" />
    <Compile Include="AttendanceCorrectionTests.cs" />
    <Compile Include="AttendanceCorrectionWorkflowTests.cs" />
    <Compile Include="RawAttendanceProcessingTests.cs" />
    <Compile Include="AttendanceGeofencingTests.cs" />
    <Compile Include="MobileEvidenceAuditTests.cs" />
    <Compile Include="BranchAttendanceLocationTests.cs" />
    <Compile Include="EmployeeProfilePayrollLockTests.cs" />
    <Compile Include="EmployeeInputValidationTests.cs" />
    <Compile Include="EmployeeHierarchyRulesTests.cs" />
    <Compile Include="EmployeeUserLinkTests.cs" />
    <Compile Include="EmployeeUserLinkModelTests.cs" />
    <Compile Include="PayrollInputWriterLockTests.cs" />
    <Compile Include="EmployeeImportPayrollLockTests.cs" />
    <Compile Include="EmployeeSalaryImportTests.cs" />
    <Compile Include="EmployeeSalaryMetadataTests.cs" />
    <Compile Include="EmployeeImportPreviewTests.cs" />
    <Compile Include="PayrollSalarySegmentTests.cs" />
    <Compile Include="PayrollCurrencyTests.cs" />
    <Compile Include="PayrollPostingTests.cs" />
    <Compile Include="PayrollGlReversalTests.cs" />
    <Compile Include="PayrollCancellationTests.cs" />
    <Compile Include="BankExportTests.cs" />
    <Compile Include="BankExportSafetyTests.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(LeavePolicySchedulerOnly)' == 'true'">
    <Compile Remove="**/*.cs" />
    <Compile Include="LeavePolicySchedulerTests.cs" />
    <Compile Include="LeaveAccrualScheduleTests.cs" />
    <Compile Include="LeaveBalanceMigrationTests.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(LeaveLedgerOnly)' == 'true'">
    <Compile Remove="**/*.cs" />
    <Compile Include="LeaveLedgerTests.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(LeaveCashoutSettlementOnly)' == 'true'">
    <Compile Remove="**/*.cs" />
    <Compile Include="LeaveCashoutSettlementTests.cs" />
    <Compile Include="PayrollAdjustmentRunLinkTests.cs" />
  </ItemGroup>

</Project>
